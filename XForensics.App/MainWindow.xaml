<ctrl:XForensicsWindow x:Class="XForensics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:XForensics.App.Controls"
        Title="XForensics"
        Subtitle="Storage Forensics &amp; Advanced Data Recovery Suite"
        Width="1140" Height="680" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragEnter" Drop="Window_Drop"
        Closing="Window_Closing">

    <!-- Window Main Layout: Dedicated Top Toolbar Row + Workspace Body Below -->
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: App Header / Drive Toolbar (Dedicated full-width row under clean title bar) -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBgBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,0,10,0">
            <ctrl:DriveToolbar x:Name="TopToolbar"/>
        </Border>

        <!-- Row 1: Workspace Grid (Left Sidebar + Center/Right Work Canvas) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar with Real Physical Device & Host Info Cards -->
            <ctrl:SidebarNavigation Grid.Column="0" x:Name="SidebarNav"/>

            <!-- Center & Right Working Area -->
            <Grid Grid.Column="1" Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="145"/>
                </Grid.RowDefinitions>

                <!-- Upper Split: File Explorer + Right Detail Panel -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="255"/>
                    </Grid.ColumnDefinitions>

                    <!-- Center: File Explorer View (Sub-tabs, Folder Tree, File Grid, Pagination) -->
                    <ctrl:FileExplorerView Grid.Column="0" x:Name="ExplorerView"/>

                    <!-- Right: File Details, Image Preview, File Info -->
                    <ctrl:FileDetailPanel Grid.Column="1" x:Name="DetailPanel" Margin="8,0,0,0"/>
                </Grid>

                <!-- Lower Split: Scan Log Terminal + Cluster Map Visualizer -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bottom Left: Scan Log Terminal -->
                    <ctrl:ScanLogPanel Grid.Column="0" x:Name="LogPanel" Margin="0,0,8,0"/>

                    <!-- Bottom Right: Cluster Map Visualizer with Legend -->
                    <ctrl:ClusterMapVisualizer Grid.Column="1" x:Name="ClusterMap"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ctrl:XForensicsWindow>
