<UserControl x:Class="XForensics.App.Controls.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Sub-Tabs -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabFileExplorer" Content="File Explorer" IsChecked="True" Click="SubTab_Click" Margin="0,0,22,0">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Cursor="Hand">
                                <TextBlock x:Name="TabText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="TabRecoveryCandidates" Content="Recovery Candidates" Click="SubTab_Click" Margin="0,0,22,0">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Cursor="Hand">
                                <TextBlock x:Name="TabText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource MutedTextBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="TabFileCarver" Content="File Carver" Click="SubTab_Click" Margin="0,0,22,0">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Cursor="Hand">
                                <TextBlock x:Name="TabText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource MutedTextBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="TabClusterMap" Content="Cluster Map" Click="SubTab_Click">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Cursor="Hand">
                                <TextBlock x:Name="TabText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource MutedTextBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Main Split: Folder Tree on Left, DataGrid on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Tree View in Card -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,6,0">
                <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          TreeViewItem.Expanded="FolderTree_Expanded"/>
            </Border>

            <!-- Splitter Line -->
            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushSoft}" HorizontalAlignment="Center"/>

            <!-- Files Table DataGrid in Card -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Margin="6,0,0,0" ClipToBounds="True">
                <DataGrid x:Name="FileGrid"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="31"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                          VerticalGridLinesBrush="Transparent"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="False"
                          SelectionChanged="FileGrid_SelectionChanged"
                          MouseDoubleClick="FileGrid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Name with Checkbox and Vector Icon -->
                        <DataGridTemplateColumn Width="3*" MinWidth="180">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Name" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{DynamicResource IconFile}"/>
                                                    <Setter Property="Fill" Value="{DynamicResource FileDefaultBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconFolder">
                                                            <Setter Property="Data" Value="{DynamicResource IconFolder}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileFolderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconWord">
                                                            <Setter Property="Data" Value="{DynamicResource IconWord}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileWordBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconPhotoshop">
                                                            <Setter Property="Data" Value="{DynamicResource IconPhotoshop}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FilePhotoshopBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconDatabase">
                                                            <Setter Property="Data" Value="{DynamicResource IconDatabase}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileDatabaseBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconImage">
                                                            <Setter Property="Data" Value="{DynamicResource IconFileImage}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileImageBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconPpt">
                                                            <Setter Property="Data" Value="{DynamicResource IconPpt}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FilePptBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconZip">
                                                            <Setter Property="Data" Value="{DynamicResource IconZip}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileZipBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKey}" Value="IconVideo">
                                                            <Setter Property="Data" Value="{DynamicResource IconVideo}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource FileVideoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size -->
                        <DataGridTemplateColumn Header="Size" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" VerticalAlignment="Center" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Modified -->
                        <DataGridTemplateColumn Header="Modified" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Modified}" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" VerticalAlignment="Center" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status with colored dot -->
                        <DataGridTemplateColumn Header="Status" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Corrupt">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Folder">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Bottom Pagination Bar -->
        <Grid Grid.Row="2" Margin="4,6,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- File counts text -->
            <TextBlock x:Name="PaginationInfoText" Grid.Column="0" Text="1 - 12 of 1,248 files (312.6 GB)"
                       FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>

            <!-- Pagination Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="PrevPage_Click" Width="26" Height="24" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Padding="0" Margin="0,0,4,0">
                    <Path Data="{DynamicResource IconChevronLeft}" Fill="{DynamicResource MutedTextBrush}" Width="8" Height="8" Stretch="Uniform"/>
                </Button>
                <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,4,0">
                    <TextBlock x:Name="CurrentPageText" Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <Button Click="NextPage_Click" Width="26" Height="24" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Padding="0" Margin="0,0,6,0">
                    <Path Data="{DynamicResource IconChevronRight}" Fill="{DynamicResource MutedTextBrush}" Width="8" Height="8" Stretch="Uniform"/>
                </Button>
                <TextBlock x:Name="TotalPagesText" Text="/ 105" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Click="LastPage_Click" Width="26" Height="24" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Padding="0">
                    <Path Data="{DynamicResource IconChevronRight}" Fill="{DynamicResource MutedTextBrush}" Width="8" Height="8" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
