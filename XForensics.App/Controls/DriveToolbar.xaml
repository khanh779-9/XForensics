<UserControl x:Class="XForensics.App.Controls.DriveToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XForensics.Core.Hardware;assembly=XForensics.Core"
             Background="Transparent">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Search / Active Tab Badge -->
        <Border Grid.Column="0"
                Background="{DynamicResource ControlBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,6"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{DynamicResource IconSearch}"
                      Fill="{DynamicResource AccentBrush}"
                      Width="13" Height="13"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>
                <TextBlock Text="Scan &amp; Recover"
                           FontWeight="SemiBold"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Button Click="CloseTab_Click"
                        Margin="10,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTip="Close active view"
                        Cursor="Hand">
                    <Path Data="{DynamicResource IconClose}"
                          Fill="{DynamicResource MutedTextBrush}"
                          Width="8" Height="8"
                          Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Drive Picker & Action Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Drive Select ComboBox with Custom Item Template -->
            <Border Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4,1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IconHardDrive}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Margin="8,0,6,0"
                          VerticalAlignment="Center"/>
                    <ComboBox x:Name="DriveComboBox"
                              MinWidth="260" MaxWidth="380"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextBrush}"
                              VerticalAlignment="Center"
                              SelectionChanged="DriveComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PhysicalDeviceInfo}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                    <Path Data="{DynamicResource IconHardDrive}"
                                          Fill="{DynamicResource MutedTextBrush}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Scan Options Button -->
            <Button x:Name="ScanOptionsButton"
                    Click="ScanOptions_Click"
                    Margin="10,0,0,0"
                    Padding="14,6"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    ToolTip="Configure FATX scan parameters &amp; file carving signatures">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IconGear}"
                          Fill="{DynamicResource MutedTextBrush}"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Scan Options"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Start / Stop Scan Button (Vibrant Electric Blue Accent) -->
            <Button x:Name="StartScanButton"
                    Click="StartScan_Click"
                    Margin="10,0,0,0"
                    Style="{DynamicResource AccentButton}"
                    Padding="18,6"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="StartScanIcon"
                          Data="{DynamicResource IconPlay}"
                          Fill="White"
                          Width="11" Height="11"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock x:Name="BtnText"
                               Text="Start Scan"
                               Foreground="White"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Status Pill Badge -->
            <Border x:Name="ScanStatusBadge"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatusGoodBgBrush}"
                    BorderBrush="{DynamicResource StatusGoodBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="StatusBadgeIcon"
                          Data="{DynamicResource IconCheckCircle}"
                          Fill="{DynamicResource SuccessBrush}"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBadgeText"
                               Text="Scan completed"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Storage & Scan Metrics on Far Right -->
        <StackPanel Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,16,0">
            <TextBlock x:Name="ScannedSizeText"
                       Text="0 GB scanned"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Right"/>
            <TextBlock x:Name="FoundFilesText"
                       Text="Found 1,248 files (312.6 GB)"
                       FontSize="10.5"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
