<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:XForensics.App.Controls">

    <!-- Implicit style for XForensicsWindow - sleek chromeless Fluent Window -->
    <Style TargetType="{x:Type controls:XForensicsWindow}">
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="38"
                                    ResizeBorderThickness="6"
                                    GlassFrameThickness="1"
                                    CornerRadius="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XForensicsWindow}">
                    <AdornerDecorator>
                        <Border x:Name="PART_WindowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- TitleBar (Dedicated, clean, spacious caption bar) -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource TitleBarBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: App Icon & Brand Titles -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,16,0"
                                                    IsHitTestVisible="False">
                                            <!-- App Vector Emblem -->
                                            <Border Width="22" Height="22"
                                                    CornerRadius="5"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconPartition}"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- App Title -->
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>

                                            <!-- Bullet Separator -->
                                            <TextBlock Text="&#x2022;"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Margin="8,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.6"/>

                                            <!-- Subtitle / Tagline -->
                                            <TextBlock Text="{TemplateBinding Subtitle}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Center: Draggable Caption Area (Optionally hosts minimal TitleBarContent if provided) -->
                                        <ContentPresenter Grid.Column="1"
                                                          Content="{TemplateBinding TitleBarContent}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                        <!-- Right: Action & Window Caption Controls -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Right"
                                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">

                                            <!-- Quick Theme Toggle Button (Dark / Light) -->
                                            <Button x:Name="PART_ThemeToggleButton"
                                                    Style="{DynamicResource WindowMinMaxButtonStyle}"
                                                    ToolTip="Toggle Dark / Light Theme"
                                                    Width="38" Height="38">
                                                <Path x:Name="PART_ThemeIcon"
                                                      Width="13" Height="13"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource MutedTextBrush}"
                                                      Data="{DynamicResource IconSun}"/>
                                            </Button>

                                            <!-- Minimize Button -->
                                            <Button x:Name="PART_MinimizeButton"
                                                    Style="{DynamicResource WindowMinMaxButtonStyle}"
                                                    ToolTip="Minimize"
                                                    Width="46" Height="38">
                                                <Path Width="10" Height="1"
                                                      Fill="{DynamicResource TextBrush}"
                                                      Data="M0,0 L10,0 L10,1 L0,1 Z"
                                                      SnapsToDevicePixels="True"/>
                                            </Button>

                                            <!-- Maximize / Restore Button -->
                                            <Button x:Name="PART_MaximizeButton"
                                                    Style="{DynamicResource WindowMinMaxButtonStyle}"
                                                    ToolTip="Maximize"
                                                    Width="46" Height="38">
                                                <Path x:Name="PART_MaximizeIcon"
                                                      Width="10" Height="10"
                                                      Stroke="{DynamicResource TextBrush}"
                                                      StrokeThickness="1"
                                                      SnapsToDevicePixels="True"
                                                      Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"/>
                                            </Button>

                                            <!-- Close Button -->
                                            <Button x:Name="PART_CloseButton"
                                                    Style="{DynamicResource WindowCloseButtonStyle}"
                                                    ToolTip="Close"
                                                    Width="46" Height="38">
                                                <Path Width="10" Height="10"
                                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      SnapsToDevicePixels="True"
                                                      Data="M0,0 L10,10 M10,0 L0,10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Window Content Body (Row 1, completely below the titlebar) -->
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_WindowBorder" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="PART_WindowBorder" Property="Padding" Value="7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
