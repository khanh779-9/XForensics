<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette Colors (Dark Mode) -->
    <Color x:Key="WindowBgColor">#070A12</Color>
    <Color x:Key="SurfaceCardColor">#0E1422</Color>
    <Color x:Key="SurfaceCardSubtleColor">#070A14</Color>
    <Color x:Key="SidebarBgColor">#060910</Color>
    <Color x:Key="BorderColor">#182336</Color>
    <Color x:Key="BorderSubtleColor">#121927</Color>
    <Color x:Key="AccentColor">#1F75FE</Color>
    <Color x:Key="AccentHoverColor">#3B82F6</Color>
    <Color x:Key="AccentSoftColor">#13223E</Color>
    <Color x:Key="AccentSelectedColor">#1D4ED8</Color>
    <Color x:Key="TextPrimaryColor">#E2E8F0</Color>
    <Color x:Key="TextSecondaryColor">#76879D</Color>
    <Color x:Key="TextMutedColor">#475569</Color>
    <Color x:Key="StatusGoodColor">#10B981</Color>
    <Color x:Key="StatusWarningColor">#F59E0B</Color>
    <Color x:Key="StatusDangerColor">#EF4444</Color>

    <!-- Standardized Brushes (VietType Compatible Names) -->
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceCardSubtleColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#13223E"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#0D1626"/>
    <SolidColorBrush x:Key="SidebarIconBrush" Color="#76879D"/>
    <SolidColorBrush x:Key="SidebarIconHoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#76879D"/>
    <SolidColorBrush x:Key="SidebarTextHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#16233B"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="{StaticResource AccentSelectedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusGoodColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource StatusDangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#0E1624"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0A0F1A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF"/>

    <!-- Backward-Compatible & Specialized FATX Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceCardSubtleBrush" Color="{StaticResource SurfaceCardSubtleColor}"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource SurfaceCardSubtleColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="StatusGoodBrush" Color="{StaticResource StatusGoodColor}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}"/>

    <!-- Status Background & Border Brushes -->
    <SolidColorBrush x:Key="StatusGoodBgBrush" Color="#0A231A"/>
    <SolidColorBrush x:Key="StatusGoodBorderBrush" Color="#144833"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#261A0A"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#4A3414"/>
    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="#280A0D"/>
    <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="#4E151B"/>

    <!-- Cluster Map Colors -->
    <SolidColorBrush x:Key="ClusterUsedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ClusterFreeBrush" Color="#121C2B"/>
    <SolidColorBrush x:Key="ClusterDeletedBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ClusterBadBrush" Color="#F59E0B"/>

    <!-- Control Specific Colors -->
    <SolidColorBrush x:Key="TopBarBgBrush" Color="#080C16"/>
    <SolidColorBrush x:Key="TitleBarBgBrush" Color="#05070E"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#0A0F1A"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#0E1624"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1A263A"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#141E2E"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#121C2E"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#1B2E4E"/>
    <SolidColorBrush x:Key="RowSelectedInactiveBrush" Color="#16243D"/>
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#080D17"/>

    <!-- System Selection Overrides (prevents WPF default whiteout when inactive) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1B2E4E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#16243D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F1F5F9"/>

    <!-- Caption Buttons Specific -->
    <SolidColorBrush x:Key="CaptionBtnHoverBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123"/>

    <!-- File Type Colors -->
    <SolidColorBrush x:Key="FileFolderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="FileWordBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="FilePhotoshopBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="FileDatabaseBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="FileImageBrush" Color="#818CF8"/>
    <SolidColorBrush x:Key="FilePptBrush" Color="#F97316"/>
    <SolidColorBrush x:Key="FileZipBrush" Color="#EAB308"/>
    <SolidColorBrush x:Key="FileVideoBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="FileDefaultBrush" Color="#94A3B8"/>

</ResourceDictionary>
